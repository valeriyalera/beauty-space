<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>C21: AI Beauty Consultant | The Beauty Space</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body { background-color: #fcfcfc; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    .chat-card { max-width: 860px; margin: 0 auto; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); }
    .chat-box { height: 480px; overflow-y: auto; background: #ffffff; border-radius: 16px; padding: 20px; border: 1px solid #f0f0f0; }
    .msg-user { background: #111; color: #fff; border-radius: 18px 18px 2px 18px; padding: 10px 16px; max-width: 75%; align-self: flex-end; }
    .msg-bot { background: #f8f9fa; color: #111; border-radius: 18px 18px 18px 2px; padding: 14px 18px; max-width: 85%; border: 1px solid #ebebeb; }
    .thought-bubble { font-size: 0.8rem; background: #eef2ff; color: #4338ca; border-left: 3px solid #6366f1; padding: 6px 12px; margin-bottom: 8px; border-radius: 4px; }
    .tool-bubble { font-size: 0.8rem; background: #ecfdf5; color: #065f46; border-left: 3px solid #10b981; padding: 6px 12px; margin-bottom: 8px; border-radius: 4px; font-family: monospace; }
  </style>
</head>
<body class="py-4">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4 max-w-860 mx-auto" style="max-width: 860px;">
      <div>
        <h1 class="h4 fw-bold mb-0">C21: ШІ-консультант The Beauty Space</h1>
        <p class="text-muted small mb-0">Server-Sent Events (SSE) • Streaming Response • Tool Calling</p>
      </div>
      <a href="/" class="btn btn-outline-dark btn-sm rounded-pill"><i class="bi bi-arrow-left me-1"></i> До магазину</a>
    </div>

    <div class="card chat-card border-0 p-4">
      <div id="chatBox" class="chat-box d-flex flex-column gap-3 mb-3">
        <div class="msg-bot">
          👋 Вітаю! Я ШІ-консультант <b>The Beauty Space</b>. Підкажіть, який засіб ви шукаєте або який у вас тип шкіри (наприклад: <i>«Підбери зволожуючу сироватку»</i>)?
        </div>
      </div>

      <div class="input-group">
        <input type="text" id="userInput" class="form-control rounded-pill-start py-2 px-3" placeholder="Запитайте щось про засоби чи догляд..." onkeydown="if(event.key==='Enter') sendMessage()">
        <button class="btn btn-dark rounded-pill-end px-4" id="sendBtn" onclick="sendMessage()">
          <i class="bi bi-send-fill me-1"></i> Надіслати
        </button>
      </div>
      <div class="d-flex gap-2 mt-2">
        <button class="btn btn-sm btn-light border rounded-pill small" onclick="quickAsk('Порадь зволожуючу сироватку')">💧 Сироватка для шкіри</button>
        <button class="btn btn-sm btn-light border rounded-pill small" onclick="quickAsk('Який крем є в наявності?')">🧴 Відновлювальний крем</button>
      </div>
    </div>
  </div>

  <script>
    const chatBox = document.getElementById('chatBox');
    const userInput = document.getElementById('userInput');
    const sendBtn = document.getElementById('sendBtn');

    function quickAsk(text) {
      userInput.value = text;
      sendMessage();
    }

    function appendMessage(sender, text, isHtml = false) {
      const msg = document.createElement('div');
      msg.className = sender === 'user' ? 'msg-user' : 'msg-bot';
      if (isHtml) msg.innerHTML = text;
      else msg.textContent = text;
      chatBox.appendChild(msg);
      chatBox.scrollTop = chatBox.scrollHeight;
      return msg;
    }

    async function sendMessage() {
      const text = userInput.value.trim();
      if (!text) return;

      appendMessage('user', text);
      userInput.value = '';
      userInput.disabled = true;
      sendBtn.disabled = true;

      const botMsg = appendMessage('bot', '', true);
      const thoughtArea = document.createElement('div');
      const textContent = document.createElement('div');
      botMsg.appendChild(thoughtArea);
      botMsg.appendChild(textContent);

      const eventSource = new EventSource(`/api/ai/chat-stream?message=${encodeURIComponent(text)}`);

      eventSource.addEventListener('thought', (e) => {
        const thought = JSON.parse(e.data);
        const div = document.createElement('div');
        div.className = 'thought-bubble';
        div.innerHTML = `<i class="bi bi-gear-wide-connected me-1"></i> ${thought}`;
        thoughtArea.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
      });

      eventSource.addEventListener('tool_result', (e) => {
        const result = JSON.parse(e.data);
        const parsed = JSON.parse(result);
        const div = document.createElement('div');
        div.className = 'tool-bubble';
        div.innerHTML = `<i class="bi bi-database-check me-1"></i> DB Result: знайдено ${parsed.count} товарів`;
        thoughtArea.appendChild(div);
        chatBox.scrollTop = chatBox.scrollHeight;
      });

      eventSource.addEventListener('token', (e) => {
        const token = JSON.parse(e.data);
        textContent.innerHTML += token.replace(/\n/g, '<br>');
        chatBox.scrollTop = chatBox.scrollHeight;
      });

      eventSource.addEventListener('done', () => {
        eventSource.close();
        userInput.disabled = false;
        sendBtn.disabled = false;
        userInput.focus();
      });

      eventSource.onerror = () => {
        eventSource.close();
        userInput.disabled = false;
        sendBtn.disabled = false;
      };
    }
  </script>
</body>
</html>