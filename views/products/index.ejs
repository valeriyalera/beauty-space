<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>The Beauty Space - Каталог</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body { background-color: #fafafa; font-family: -apple-system, BlinkMacSystemFont, sans-serif; color: #1c1c1c; }
    .product-img { height: 240px; object-fit: contain; padding: 15px; background: #f4f4f4; }
    .card { border-radius: 0; }
  </style>
</head>
<body class="p-4">
  <div class="container">
    <header class="d-flex justify-content-between align-items-center mb-5 pb-3 border-bottom">
      <h1 class="h3 m-0">The Beauty Space</h1>
      <button class="btn btn-dark" data-bs-toggle="modal" data-bs-target="#createModal">+ Додати товар</button>
    </header>

    <div class="d-flex justify-content-between align-items-end mb-4">
      <h2 class="h5 text-uppercase m-0">Bestsellers</h2>
      <span class="text-muted small">Всього: <%= products.length %></span>
    </div>

    <div class="row g-4">
      <% products.forEach(p => { %>
        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0">
            <img src="<%= p.image_url %>" class="card-img-top product-img" alt="<%= p.title %>">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <span class="badge bg-secondary mb-2"><%= p.category_name %></span>
                <h5 class="card-title"><%= p.title %></h5>
                <p class="text-muted small"><%= p.volume_ml %> мл</p>
                <p class="card-text text-muted small"><%= p.description %></p>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                <span class="fw-bold fs-5"><%= p.price %> ₴</span>
                <div>
                  <a href="/products/<%= p.id %>" class="btn btn-sm btn-outline-dark">Деталі</a>
                  <a href="/products/<%= p.id %>/edit" class="btn btn-sm btn-outline-secondary">Ред.</a>
                  <form action="/products/<%= p.id %>/delete" method="POST" class="d-inline">
                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Видалити цей товар?')">×</button>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- Модальне вікно додавання товару (Create) -->
  <div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <form action="/products" method="POST" enctype="multipart/form-data">
          <div class="modal-header">
            <h5 class="modal-title">Додати новий товар</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">Назва</label>
              <input type="text" name="title" class="form-control" required placeholder="Hydra-Glow Cream">
            </div>
            <div class="mb-3">
              <label class="form-label">Категорія</label>
              <select name="category_id" class="form-select">
                <% categories.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="row mb-3">
              <div class="col">
                <label class="form-label">Ціна (₴)</label>
                <input type="number" step="0.01" name="price" class="form-control" required>
              </div>
              <div class="col">
                <label class="form-label">Об'єм (мл)</label>
                <input type="number" name="volume_ml" class="form-control" required>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">Опис</label>
              <textarea name="description" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
              <label class="form-label">Фото флакону / баночки (Файл)</label>
              <input type="file" name="image" class="form-control" accept="image/*" required>
            </div>
          </div>
          <div class="modal-footer">
            <button type="submit" class="btn btn-dark w-100">Зберегти</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>