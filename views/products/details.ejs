<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.title %> - The Beauty Space</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4 bg-light">
  <div class="container py-4">
    <a href="/" class="btn btn-outline-dark mb-4">← Назад до каталогу</a>
    <div class="row bg-white p-4 shadow-sm">
      <div class="col-md-5 text-center bg-light p-3">
        <img src="<%= product.image_url %>" class="img-fluid" style="max-height: 400px;" alt="<%= product.title %>">
      </div>
      <div class="col-md-7 ps-md-5 d-flex flex-column justify-content-center">
        <span class="badge bg-secondary mb-2 align-self-start"><%= product.category_name %></span>
        <h1 class="display-6"><%= product.title %></h1>
        <h3 class="my-3"><%= product.price %> ₴</h3>
        <p class="text-muted"><%= product.volume_ml %> мл</p>
        <p class="lead text-secondary"><%= product.description %></p>
      </div>
    </div>
  </div>
</body>
</html>