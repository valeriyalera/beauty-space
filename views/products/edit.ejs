<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Редагувати: <%= product.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="p-4 bg-light">
  <div class="container" style="max-width: 600px;">
    <a href="/" class="btn btn-outline-dark mb-3">← Назад</a>
    <div class="card p-4 shadow-sm border-0">
      <h3 class="mb-3">Редагування товару</h3>
      <form action="/products/<%= product.id %>/edit" method="POST">
        <div class="mb-3">
          <label class="form-label">Назва</label>
          <input type="text" name="title" value="<%= product.title %>" class="form-control" required>
        </div>
        <div class="mb-3">
          <label class="form-label">Категорія</label>
          <select name="category_id" class="form-select">
            <% categories.forEach(c => { %>
              <option value="<%= c.id %>" <%= c.id === product.category_id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="row mb-3">
          <div class="col">
            <label class="form-label">Ціна (₴)</label>
            <input type="number" step="0.01" name="price" value="<%= product.price %>" class="form-control" required>
          </div>
          <div class="col">
            <label class="form-label">Об'єм (мл)</label>
            <input type="number" name="volume_ml" value="<%= product.volume_ml %>" class="form-control" required>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Опис</label>
          <textarea name="description" class="form-control" rows="3"><%= product.description %></textarea>
        </div>
        <div class="mb-3">
          <label class="form-label">Посилання на фото (URL)</label>
          <input type="url" name="image_url" value="<%= product.image_url %>" class="form-control" placeholder="https://example.com/photo.jpg">
        </div>
        <button type="submit" class="btn btn-dark w-100">Зберегти зміни</button>
      </form>
    </div>
  </div>
</body>
</html>