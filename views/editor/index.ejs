<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>C12/C13/C14: Beauty Notes Editor | The Beauty Space</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body { background-color: #fbfbfa; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #37352f; }
    .editor-wrapper { max-width: 820px; margin: 40px auto; padding: 0 20px; }
    .editor-title { font-size: 2.2rem; font-weight: 700; border: none; outline: none; width: 100%; background: transparent; margin-bottom: 25px; }
    .drag-handle {
      cursor: grab;
      color: #9ca3af;
      padding: 2px 4px;
      display: flex;
      align-items: center;
      user-select: none;
    }
    .drag-handle:active { cursor: grabbing; }
    .notion-block.dragging {
      opacity: 0.35;
      background: #eef2ff;
      border: 1px dashed #6366f1;
    }
    .notion-block.drag-over {
      border-top: 2px solid #111;
    }

    .notion-block {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 6px;
      padding: 6px 8px;
      border-radius: 8px;
      position: relative;
      border: 1px solid transparent;
      transition: background-color 0.25s ease, border-color 0.25s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .notion-block:hover { background-color: rgba(55, 53, 47, 0.04); }
    .block-controls { opacity: 0; transition: opacity 0.15s; display: flex; align-items: center; gap: 4px; padding-top: 3px; }
    .notion-block:hover .block-controls { opacity: 1; }
    
    .block-content {
      flex: 1;
      outline: none;
      word-break: break-word;
      min-height: 26px;
      line-height: 1.6;
    }
    .block-content[placeholder]:empty:before {
      content: attr(placeholder);
      color: rgba(55, 53, 47, 0.35);
      cursor: text;
    }

    .type-h1 { font-size: 1.6rem; font-weight: 700; margin-top: 15px; }
    .type-h2 { font-size: 1.3rem; font-weight: 600; margin-top: 10px; }
    .type-p { font-size: 1rem; }
    .type-todo { display: flex; align-items: center; gap: 8px; font-size: 1rem; }
    .type-todo input[type="checkbox"] { width: 17px; height: 17px; cursor: pointer; accent-color: #111; }
    .type-todo.done .block-content { text-decoration: line-through; color: #9ca3af; }
    .type-quote { border-left: 3px solid #111; padding-left: 14px; font-style: italic; color: #4b5563; }


    @keyframes remotePulse {
      0% { background-color: rgba(99, 102, 241, 0.25); border-color: #6366f1; transform: scale(1.01); }
      50% { background-color: rgba(99, 102, 241, 0.12); border-color: #818cf8; }
      100% { background-color: transparent; border-color: transparent; transform: scale(1); }
    }

    .notion-block.remote-highlight {
      animation: remotePulse 1.4s ease-out;
    }

    .remote-presence-tag {
      position: absolute;
      top: -10px;
      right: 12px;
      background: #6366f1;
      color: #fff;
      font-size: 0.7rem;
      padding: 1px 7px;
      border-radius: 10px;
      pointer-events: none;
      box-shadow: 0 2px 5px rgba(0,0,0,0.15);
      animation: fadeInOut 1.4s ease-out forwards;
    }

    @keyframes fadeInOut {
      0% { opacity: 0; transform: translateY(4px); }
      15% { opacity: 1; transform: translateY(0); }
      80% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-4px); }
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-light bg-white border-bottom py-2">
    <div class="container-fluid px-4">
      <div class="d-flex align-items-center gap-2">
        <a href="/" class="btn btn-outline-dark btn-sm rounded-pill px-3">
          <i class="bi bi-arrow-left me-1"></i> Магазин
        </a>
        <span class="badge bg-light text-dark border rounded-pill px-3 py-2 ms-2">
          <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Автозбереження (localStorage)
        </span>
        <span id="syncStatusBadge" class="badge bg-light text-secondary border rounded-pill px-3 py-2 ms-1">
          <i class="bi bi-broadcast me-1"></i> <span id="syncText">Синхронізація (C13/C14)</span>
        </span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <button id="addBlockBtn" class="btn btn-dark btn-sm rounded-pill px-3">
          <i class="bi bi-plus-lg me-1"></i> Додати блок
        </button>
        <button id="resetBtn" class="btn btn-outline-danger btn-sm rounded-pill px-3">
          <i class="bi bi-arrow-counterclockwise me-1"></i> Очистити
        </button>
      </div>
    </div>
  </nav>

  <div class="editor-wrapper">
    <input type="text" id="docTitle" class="editor-title" placeholder="Без назви (напр. Схема щоденного догляду)...">
    <div id="blocksContainer"></div>
  </div>

  <script>
    const STORAGE_KEY = 'beauty_space_notion_doc';
    const container = document.getElementById('blocksContainer');
    const docTitle = document.getElementById('docTitle');
    let isRemoteUpdate = false;

    const protocol = window.location.protocol === 'https:' ? 'wss:' : 'ws:';
    const ws = new WebSocket(`${protocol}//${window.location.host}/ws/editor`);

    ws.onopen = () => {
      const syncBadge = document.getElementById('syncStatusBadge');
      const syncText = document.getElementById('syncText');
      if (syncBadge && syncText) {
        syncBadge.classList.replace('text-secondary', 'text-success');
        syncText.innerText = 'Live Sync & Motion (C14)';
      }
      ws.send(JSON.stringify({ type: 'editor_init' }));
    };

    ws.onmessage = (event) => {
      try {
        const msg = JSON.parse(event.data);
        if (msg.type === 'editor_sync' && msg.doc) {
          isRemoteUpdate = true;
          localStorage.setItem(STORAGE_KEY, JSON.stringify(msg.doc));
          applyDocumentData(msg.doc, msg.changedBlockId);
          isRemoteUpdate = false;
        }
      } catch (e) {
        console.error('Помилка синхронізації:', e);
      }
    };

    const defaultData = {
      title: "Ранкова б'юті-рутина та догляд",
      blocks: [
        { id: 'b1', type: 'h1', text: '1. Базові етапи догляду' },
        { id: 'b2', type: 'todo', text: 'Очищення м\'якою пінкою без сульфатів', checked: true },
        { id: 'b3', type: 'todo', text: 'Тонізація відновлювальним тонером з керамідами', checked: false },
        { id: 'b4', type: 'todo', text: 'Нанесення сироватки SkinMuse Hydrating Serum', checked: false },
        { id: 'b5', type: 'h2', text: 'Корисна порада дерматолога' },
        { id: 'b6', type: 'quote', text: 'Сонцезахисний крем (SPF 50+) наноситься останнім шаром за 15 хв до виходу.' }
      ]
    };

    function loadDocument() {
      const saved = localStorage.getItem(STORAGE_KEY);
      if (saved) {
        try { return JSON.parse(saved); } catch (e) { return defaultData; }
      }
      return defaultData;
    }

    function saveDocument(modifiedBlockId = null) {
      if (isRemoteUpdate) return;

      const blocks = [];
      document.querySelectorAll('.notion-block').forEach(el => {
        const type = el.dataset.type;
        const textEl = el.querySelector('.block-content');
        const text = textEl ? textEl.innerText.trim() : '';
        const checkbox = el.querySelector('input[type="checkbox"]');
        const checked = checkbox ? checkbox.checked : false;

        blocks.push({
          id: el.dataset.id,
          type: type,
          text: text,
          checked: checked
        });
      });

      const data = {
        title: docTitle.value,
        blocks: blocks
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(data));

      if (ws.readyState === WebSocket.OPEN) {
        ws.send(JSON.stringify({
          type: 'editor_update',
          doc: data,
          changedBlockId: modifiedBlockId
        }));
      }
    }

    function applyDocumentData(data, changedBlockId = null) {
      docTitle.value = data.title || '';
      container.innerHTML = '';
      (data.blocks || []).forEach(b => {
        const el = createBlockElement(b);
        container.appendChild(el);

        if (changedBlockId && b.id === changedBlockId) {
          el.classList.add('remote-highlight');
          const badge = document.createElement('span');
          badge.className = 'remote-presence-tag';
          badge.innerHTML = '<i class="bi bi-pencil-fill me-1"></i> Змінено онлайн';
          el.appendChild(badge);
          setTimeout(() => {
            el.classList.remove('remote-highlight');
            badge.remove();
          }, 1400);
        }
      });
    }

    function createBlockElement(block) {
      const div = document.createElement('div');
      div.className = `notion-block type-${block.type}`;
      div.dataset.id = block.id || 'b_' + Date.now() + Math.random().toString(36).substr(2, 4);
      div.dataset.type = block.type || 'p';
      div.draggable = true;
      div.setAttribute('draggable', 'true');

      if (block.type === 'todo' && block.checked) {
        div.classList.add('done');
      }

      div.innerHTML = `
        <div class="block-controls">
          <span class="drag-handle" title="Перетягнути"><i class="bi bi-grip-vertical"></i></span>
          <select class="form-select form-select-sm block-type-select py-0 px-2" style="font-size: 0.75rem; width: 85px;">
            <option value="p" ${block.type === 'p' ? 'selected' : ''}>Текст</option>
            <option value="h1" ${block.type === 'h1' ? 'selected' : ''}>Заголовок 1</option>
            <option value="h2" ${block.type === 'h2' ? 'selected' : ''}>Заголовок 2</option>
            <option value="todo" ${block.type === 'todo' ? 'selected' : ''}>To-Do</option>
            <option value="quote" ${block.type === 'quote' ? 'selected' : ''}>Цитата</option>
          </select>
          <button class="btn btn-sm btn-link text-danger p-0 delete-btn" title="Видалити блок">
            <i class="bi bi-x-lg"></i>
          </button>
        </div>
      `;

      if (block.type === 'todo') {
        const chk = document.createElement('input');
        chk.type = 'checkbox';
        chk.checked = !!block.checked;
        chk.addEventListener('change', () => {
          div.classList.toggle('done', chk.checked);
          saveDocument(div.dataset.id);
        });
        div.appendChild(chk);
      }

      const content = document.createElement('div');
      content.className = 'block-content';
      content.contentEditable = true;
      content.placeholder = block.type.startsWith('h') ? 'Заголовок...' : 'Введіть текст нотатки...';
      content.innerText = block.text || '';

      content.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && !e.shiftKey) {
          e.preventDefault();
          const newBlock = createBlockElement({ type: 'p', text: '' });
          div.after(newBlock);
          newBlock.querySelector('.block-content').focus();
          saveDocument(newBlock.dataset.id);
        } else if (e.key === 'Backspace' && content.innerText.trim() === '' && container.children.length > 1) {
          e.preventDefault();
          const prev = div.previousElementSibling;
          div.remove();
          if (prev && prev.querySelector('.block-content')) {
            prev.querySelector('.block-content').focus();
          }
          saveDocument();
        }
      });

      content.addEventListener('input', () => saveDocument(div.dataset.id));
      div.appendChild(content);

      div.addEventListener('dragstart', (e) => {
        div.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
      });

      div.addEventListener('dragend', () => {
        div.classList.remove('dragging');
        document.querySelectorAll('.notion-block').forEach(b => b.classList.remove('drag-over'));
        saveDocument(div.dataset.id);
      });

      div.addEventListener('dragover', (e) => {
        e.preventDefault();
        div.classList.add('drag-over');
      });

      div.addEventListener('dragleave', () => {
        div.classList.remove('drag-over');
      });

      div.addEventListener('drop', (e) => {
        e.preventDefault();
        div.classList.remove('drag-over');
        const draggingEl = document.querySelector('.notion-block.dragging');
        if (draggingEl && draggingEl !== div) {
          container.insertBefore(draggingEl, div);
          saveDocument(draggingEl.dataset.id);
        }
      });

      const select = div.querySelector('.block-type-select');
      select.addEventListener('change', (e) => {
        const newType = e.target.value;
        const currentText = content.innerText;
        const newBlock = createBlockElement({ type: newType, text: currentText });
        div.replaceWith(newBlock);
        newBlock.querySelector('.block-content').focus();
        saveDocument(newBlock.dataset.id);
      });

      div.querySelector('.delete-btn').addEventListener('click', () => {
        if (container.children.length > 1) {
          div.remove();
          saveDocument();
        }
      });

      return div;
    }

    function render() {
      applyDocumentData(loadDocument());
    }

    docTitle.addEventListener('input', () => saveDocument());

    document.getElementById('addBlockBtn').addEventListener('click', () => {
      const b = createBlockElement({ type: 'p', text: '' });
      container.appendChild(b);
      b.querySelector('.block-content').focus();
      saveDocument(b.dataset.id);
    });

    document.getElementById('resetBtn').addEventListener('click', () => {
      if (confirm('Скинути документ до початкового стану?')) {
        localStorage.removeItem(STORAGE_KEY);
        render();
        saveDocument();
      }
    });

    render();
  </script>
</body>
</html>