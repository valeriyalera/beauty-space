<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Наявність та статистика | The Beauty Space</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin=""/>

  <style>
    body {
      background-color: #fbfbfb;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    #map {
      height: 520px;
      width: 100%;
      border-radius: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.06);
      z-index: 1;
    }
    .point-card {
      cursor: pointer;
      border: 1px solid #ebebeb;
      border-radius: 14px;
      padding: 16px;
      transition: all 0.2s ease;
      background: #fff;
    }
    .point-card:hover {
      border-color: #111;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.06);
    }
    .badge-stock {
      background-color: #e8f5e9;
      color: #2e7d32;
      font-size: 0.75rem;
      padding: 4px 8px;
      border-radius: 6px;
      font-weight: 600;
    }
    .chart-box {
      background: #ffffff;
      border: 1px solid #eeeeee;
      border-radius: 18px;
      padding: 24px;
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
      height: 100%;
    }
  </style>
</head>
<body>

  <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-3">
    <div class="container">
      <a class="navbar-brand fw-bold text-uppercase" href="/">The Beauty Space</a>
      <div class="d-flex align-items-center gap-3">
        <a href="#stats" class="text-decoration-none text-muted small fw-medium d-none d-sm-inline">
          <i class="bi bi-bar-chart-fill me-1"></i> Статистика (F1)
        </a>
        <a href="/" class="btn btn-outline-dark btn-sm rounded-pill px-3">← До каталогу товарів</a>
      </div>
    </div>
  </nav>

  <div class="container py-5">

    <div class="row mb-4 align-items-end">
      <div class="col-lg-6">
        <span class="text-uppercase small fw-bold text-muted">C8: Сторонній API OpenStreetMap + Сутності моделі</span>
        <h1 class="fw-bold mt-1 mb-2">Наявність товарів у точках видачі</h1>
        <p class="text-secondary mb-0">Оберіть товар з моделі проєкту, щоб побачити, у яких бутиках він є в наявності.</p>
      </div>

      <div class="col-lg-6 mt-3 mt-lg-0">
        <div class="bg-white p-3 rounded-4 border shadow-sm d-flex flex-column flex-sm-row align-items-sm-center gap-3">
          <label for="productFilter" class="fw-bold small text-nowrap mb-0">
            <i class="bi bi-funnel me-1"></i> Товар з каталогу:
          </label>
          <select id="productFilter" class="form-select rounded-pill" onchange="onProductSelect(this.value)">
            <option value="all">Усі товари (всі точки)</option>
            <% products.forEach(function(prod) { %>
              <option value="<%= prod.id %>"><%= prod.title %> (<%= prod.price %> ₴)</option>
            <% }); %>
          </select>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-5">
      <div class="col-lg-4">
        <div class="d-flex flex-column gap-3" id="pointsList" style="max-height: 520px; overflow-y: auto;">
          <% pickupPoints.forEach(function(pt) { %>
            <div class="point-card" id="card-<%= pt.id %>" data-lat="<%= pt.lat %>" data-lng="<%= pt.lng %>" data-name="<%= pt.name %>">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge bg-dark text-white rounded-pill px-2 py-1 small"><%= pt.city %></span>
                <span class="badge-stock"><i class="bi bi-check2-circle me-1"></i>Точка активна</span>
              </div>
              <h5 class="fw-bold mb-1 fs-6"><%= pt.name %></h5>
              <div class="text-muted small mb-1"><i class="bi bi-geo-alt me-1"></i><%= pt.address %></div>
              <div class="text-muted small mb-2"><i class="bi bi-clock me-1"></i><%= pt.hours %></div>

              <div class="pt-2 border-top mt-2">
                <div class="small fw-semibold mb-1 text-secondary">У наявності з каталогу:</div>
                <div class="d-flex flex-wrap gap-1">
                  <% 
                    const availableProds = products.filter(p => pt.productIds.includes(p.id));
                    availableProds.forEach(function(p) {
                  %>
                    <span class="badge bg-light text-dark border small"><%= p.title %></span>
                  <% }); %>
                </div>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <div class="col-lg-8">
        <div id="map"></div>
      </div>
    </div>

    
    <section id="stats" class="pt-4 border-top">
      <div class="mb-4">
        <span class="text-uppercase small fw-bold text-muted">F1: Візуалізація статистики (Chart.js)</span>
        <h2 class="fw-bold mt-1">Аналітика мережі та асортименту</h2>
        <p class="text-secondary small">Статистичні діаграми побудовані динамічно за даними сутностей інтернет-магазину.</p>
      </div>

      <div class="row g-4">
        <div class="col-lg-7">
          <div class="chart-box">
            <h5 class="fw-bold fs-6 mb-3"><i class="bi bi-buildings me-2"></i>Кількість найменувань у наявності по точках</h5>
            <div>
              <canvas id="storesChart" height="200"></canvas>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="chart-box">
            <h5 class="fw-bold fs-6 mb-3"><i class="bi bi-pie-chart me-2"></i>Структура каталогу за категоріями</h5>
            <div style="max-height: 250px; display: flex; justify-content: center;">
              <canvas id="categoriesChart"></canvas>
            </div>
          </div>
        </div>
      </div>
    </section>

  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script id="data-products" type="application/json"><%- JSON.stringify(products) %></script>
  <script id="data-points" type="application/json"><%- JSON.stringify(pickupPoints) %></script>
  <script id="data-stats" type="application/json"><%- JSON.stringify(categoryStats || []) %></script>

  <script>
    const allProducts = JSON.parse(document.getElementById('data-products').textContent || '[]');
    const allPoints = JSON.parse(document.getElementById('data-points').textContent || '[]');
    const catStats = JSON.parse(document.getElementById('data-stats').textContent || '[]');

    const map = L.map('map').setView([49.0, 31.5], 6);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '© OpenStreetMap'
    }).addTo(map);

    let markers = [];

    function updateMap(selectedProductId) {
      const filterId = selectedProductId || 'all';

      markers.forEach(function(m) {
        map.removeLayer(m);
      });
      markers = [];

      const filteredPoints = filterId === 'all'
        ? allPoints
        : allPoints.filter(function(pt) {
            return pt.productIds.indexOf(Number(filterId)) !== -1;
          });

      allPoints.forEach(function(pt) {
        const card = document.getElementById('card-' + pt.id);
        if (card) {
          const isVisible = filterId === 'all' || pt.productIds.indexOf(Number(filterId)) !== -1;
          card.style.display = isVisible ? 'block' : 'none';
        }
      });

      filteredPoints.forEach(function(pt) {
        const marker = L.marker([pt.lat, pt.lng]).addTo(map);

        const inStockTitles = allProducts
          .filter(function(p) {
            return pt.productIds.indexOf(p.id) !== -1;
          })
          .map(function(p) {
            return '• <b>' + p.title + '</b> (' + p.price + ' ₴)';
          })
          .join('<br/>');

        marker.bindPopup(
          '<div style="font-family: sans-serif; font-size: 13px; line-height: 1.4;">' +
            '<b style="font-size: 14px;">' + pt.name + '</b><br/>' +
            '<span style="color: #666;">📍 ' + pt.address + '</span><br/>' +
            '<span style="color: #666;">🕒 ' + pt.hours + '</span><br/>' +
            '<hr style="margin: 6px 0;" />' +
            '<div style="color: #2e7d32; font-weight: bold; margin-bottom: 3px;">В наявності:</div>' +
            inStockTitles +
          '</div>'
        );

        markers.push(marker);
      });

      if (markers.length > 0) {
        const group = new L.featureGroup(markers);
        map.fitBounds(group.getBounds().pad(0.25));
      }
    }

    updateMap('all');

    function onProductSelect(prodId) {
      updateMap(prodId);
    }

    document.querySelectorAll('.point-card').forEach(function(card) {
      card.addEventListener('click', function() {
        const lat = parseFloat(this.getAttribute('data-lat'));
        const lng = parseFloat(this.getAttribute('data-lng'));
        map.flyTo([lat, lng], 14, { duration: 1.2 });
        const target = markers.find(function(m) {
          const pos = m.getLatLng();
          return pos.lat === lat && pos.lng === lng;
        });
        if (target) {
          target.openPopup();
        }
      });
    });

    const storeLabels = allPoints.map(function(p) {
      return p.name.replace('The Beauty Space — ', '');
    });
    const storeCounts = allPoints.map(function(p) {
      return p.productIds.length;
    });

    const ctxStore = document.getElementById('storesChart').getContext('2d');
    new Chart(ctxStore, {
      type: 'bar',
      data: {
        labels: storeLabels,
        datasets: [{
          label: 'Товарів у наявності',
          data: storeCounts,
          backgroundColor: '#111111',
          borderRadius: 8,
          barThickness: 36
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: { stepSize: 1 }
          }
        }
      }
    });

    const catLabels = catStats.length > 0
      ? catStats.map(function(c) { return c.name; })
      : ['Creams', 'Serums', 'Lipsticks'];
    const catCounts = catStats.length > 0
      ? catStats.map(function(c) { return Number(c.count); })
      : [2, 1, 1];

    const ctxCat = document.getElementById('categoriesChart').getContext('2d');
    new Chart(ctxCat, {
      type: 'doughnut',
      data: {
        labels: catLabels,
        datasets: [{
          data: catCounts,
          backgroundColor: ['#111111', '#555555', '#999999', '#d1d1d1'],
          borderWidth: 2,
          borderColor: '#ffffff'
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { position: 'bottom' }
        }
      }
    });
  </script>
</body>
</html>